# Переменные окружения для локальной разработки. Не коммитьте заполненный .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash-lite
DATABASE_URL=jdbc:postgresql://localhost:5432/speaking_character
DATABASE_USER=speaking_character
DATABASE_PASSWORD=speaking_character
POSTGRES_DB=speaking_character
POSTGRES_PORT=5432
PORT=8080
MAX_CONTEXT_MESSAGES=20
FRONTEND_HOST=localhost:8000
CHAT_API_URL=http://localhost:8080
# did сохраняет текущий режим. Для потокового avatar pipeline укажите simli.
AVATAR_PROVIDER=did
DID_API_KEY=
# Настройки требуются только при AVATAR_PROVIDER=simli и никогда не передаются браузеру.
SIMLI_API_KEY=
SIMLI_FACE_ID=
SIMLI_TRANSPORT=livekit
SIMLI_MAX_SESSION_SECONDS=600
SIMLI_MAX_IDLE_SECONDS=60
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
STREAM_MIN_CHARS=50
